# Aivora Environment Configuration Template
# Core Aivora functions 100% without external API keys!
# All variables below are strictly OPTIONAL.

# Base URL for canonical meta tags & sitemaps
NEXT_PUBLIC_SITE_URL=https://aivora.dev

# Optional: Local Ollama endpoint override (default is http://localhost:11434)
NEXT_PUBLIC_OLLAMA_ENDPOINT=http://localhost:11434
